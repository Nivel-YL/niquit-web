---
import { type Lang, LANGS, t, localePath, canonicalPath, stripLocalePrefix } from '../i18n/ui';
import InstallButton from './InstallButton.astro';
import { GOOGLE_URL, APPLE_URL } from '../config/stores';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);

const langCode: Record<string, string> = { en:'EN', ru:'RU', de:'DE', es:'ES', fr:'FR' };
const langName: Record<string, string> = {
  en: 'English', ru: 'Русский', de: 'Deutsch', es: 'Español', fr: 'Français',
};

// build.format:'file' makes Astro.url.pathname carry a .html extension (and
// literally /index.html at root) - canonicalPath() strips that back to the
// clean URL before stripping the locale prefix, so the switcher never links
// to a *.html path (which would 404, nothing serves it under 'file' format).
const currentPathNoLang = stripLocalePrefix(canonicalPath(Astro.url));
const otherLangs = LANGS.filter((l) => l !== lang);

const navLinks = [
  { href: localePath(lang),            label: s.nav.home },
  { href: localePath(lang, 'method'),  label: s.nav.method },
  { href: localePath(lang, 'blog'),    label: s.nav.blog },
  { href: localePath(lang, 'support'), label: s.nav.support },
];
---

<header
  class="sticky top-0 z-50 flex items-center justify-between px-5 sm:px-8 h-16"
  style="background:rgba(12,20,36,0.92); backdrop-filter:blur(12px); border-bottom:1px solid #18243F;"
>
  <div class="flex items-center gap-2">
    <!-- Mobile hamburger (full-screen overlay below) -->
    <button
      type="button"
      class="sm:hidden inline-flex items-center justify-center rounded-lg"
      style="width:44px; height:44px; border:1px solid #22314F; background:#131E33; color:#EAF1FF;"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-btn
    >
      <span data-menu-icon style="font-size:18px; line-height:1;">☰</span>
    </button>

    <a href={localePath(lang)} class="flex items-center gap-2 no-underline">
      <img src="/logo.svg" alt="NiQuit" class="h-8 w-auto" />
    </a>
  </div>

  <nav class="hidden sm:flex items-center gap-6 text-sm font-medium" style="color:#B0B8C8;">
    {navLinks.map((l) => (
      <a href={l.href} class="hover:text-white transition-colors tap-pad">{l.label}</a>
    ))}
  </nav>

  <div class="flex items-center gap-3">
    <!-- Language switcher — JS click-based -->
    <div class="lang" data-lang-switcher>
      <button type="button" class="lang__btn" aria-haspopup="listbox" aria-expanded="false">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="#35C6D8" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <ellipse cx="12" cy="12" rx="4" ry="9"/>
        </svg>
        <span class="lang__code">{langCode[lang]}</span>
        <svg class="lang__caret" width="10" height="10" viewBox="0 0 12 12"
             fill="none" stroke="#93A6C6" stroke-width="1.8" aria-hidden="true">
          <path d="M2 4l4 4 4-4"/>
        </svg>
      </button>

      <ul class="lang__menu" role="listbox" hidden>
        {otherLangs.map((l) => (
          <li role="option">
            <a href={localePath(l, currentPathNoLang)} data-ph-from={lang} data-ph-to={l}>
              <b>{langCode[l]}</b>{langName[l]}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <InstallButton lang={lang} size="sm" location="header" />
  </div>
</header>

<!-- Mobile nav overlay (ТЗ §2.3) -->
<div
  id="mobile-nav"
  class="sm:hidden"
  data-menu-panel
  hidden
  style="position:fixed; inset:0; top:64px; z-index:45; background:#0B1220; flex-direction:column; padding:10px 20px 30px;"
>
  {navLinks.map((l) => (
    <a
      href={l.href}
      data-menu-link
      style="display:flex; align-items:center; min-height:52px; padding:16px 6px; font-size:18px; font-weight:500; color:#EAF1FF; border-bottom:1px solid #22314F; text-decoration:none;"
    >{l.label}</a>
  ))}
  <a
    href={GOOGLE_URL}
    target="_blank"
    rel="noopener"
    data-store-link
    data-apple-href={APPLE_URL}
    data-ph-install="mobile-menu"
    data-menu-link
    style="display:inline-flex; align-items:center; justify-content:center; margin-top:22px; min-height:48px; border-radius:10px; background:#35C6D8; color:#06232A; font-weight:600; font-size:15px; text-decoration:none;"
  >{s.hero.cta}</a>
</div>

<script>
  // Language dropdown
  document.querySelectorAll('[data-lang-switcher]').forEach((root) => {
    const btn  = root.querySelector('.lang__btn') as HTMLButtonElement;
    const menu = root.querySelector('.lang__menu') as HTMLElement;
    const open  = () => { menu.hidden = false; btn.setAttribute('aria-expanded', 'true'); };
    const close = () => { menu.hidden = true;  btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', (e) => { e.stopPropagation(); menu.hidden ? open() : close(); });
    menu.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a[data-ph-from]') as HTMLElement | null;
      if (link) {
        (window as any).posthog?.capture('language_switched', {
          platform: 'website',
          from_lang: link.dataset.phFrom,
          to_lang: link.dataset.phTo,
        });
      }
      close();
    });
    document.addEventListener('click',  (e) => { if (!root.contains(e.target as Node)) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  });

  // Mobile menu overlay
  (function mobileMenu() {
    const btn = document.querySelector('[data-menu-btn]') as HTMLButtonElement | null;
    const panel = document.querySelector('[data-menu-panel]') as HTMLElement | null;
    const icon = document.querySelector('[data-menu-icon]') as HTMLElement | null;
    if (!btn || !panel || !icon) return;

    const open = () => {
      panel.hidden = false;
      panel.style.display = 'flex';
      btn.setAttribute('aria-expanded', 'true');
      icon.textContent = '✕';
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      panel.hidden = true;
      panel.style.display = 'none';
      btn.setAttribute('aria-expanded', 'false');
      icon.textContent = '☰';
      document.body.style.overflow = '';
    };
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    btn.addEventListener('click', () => (isOpen() ? close() : open()));
    panel.querySelectorAll('[data-menu-link]').forEach((el) =>
      el.addEventListener('click', close)
    );
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && isOpen()) close(); });
    window.addEventListener('resize', () => { if (window.innerWidth >= 640 && isOpen()) close(); });
  })();
</script>

---
import { type Lang, t, localePath } from '../i18n/ui';

type Cluster = 'A' | 'B' | 'C' | 'D' | 'E' | 'F' | 'G' | 'H';

interface Props {
  lang: Lang;
  title: string;
  slug: string;
  publishDate: Date;
  cluster?: Cluster;
}

const { lang, title, slug, publishDate, cluster } = Astro.props;
const s = t(lang);

const dateStr = publishDate.toLocaleDateString(
  lang === 'ru' ? 'ru-RU' : lang === 'de' ? 'de-DE' : lang === 'es' ? 'es-ES' : lang === 'fr' ? 'fr-FR' : 'en-US',
  { year: 'numeric', month: 'short', day: 'numeric' }
);
const catLabel = cluster ? s.blog.categories[cluster] : '';

const href = localePath(lang, `blog/${slug}`);
---

<a
  href={href}
  class="card group flex flex-col justify-center rounded-2xl transition-transform hover:-translate-y-1"
  style="padding:24px; height:184px; background:#18243F; border:1px solid #22314F; text-decoration:none; overflow:hidden;"
  data-cluster={cluster ?? ''}
  data-ts={publishDate.valueOf()}
>
  <div class="flex items-center justify-between gap-2.5">
    {catLabel && (
      <span
        class="text-[10.5px] font-semibold whitespace-nowrap rounded-full"
        style="font-family:'JetBrains Mono',monospace; letter-spacing:0.8px; padding:4px 10px; color:#67E8F9; background:rgba(53,198,216,.06); border:1px solid rgba(53,198,216,.3);"
      >
        {catLabel}
      </span>
    )}
    <span class="text-[11px] whitespace-nowrap" style="font-family:'JetBrains Mono',monospace; color:#5a6b8a;">{dateStr}</span>
  </div>
  <h3
    class="font-bold group-hover:text-cyan-300 transition-colors"
    style="font-family:'Montserrat',sans-serif; font-size:20px; line-height:1.34; color:#F5F7FA; margin-top:14px; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden;"
  >
    {title}
  </h3>
</a>

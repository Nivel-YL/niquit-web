---
import Base from '../../layouts/Base.astro';
import InstallButton from '../InstallButton.astro';
import Calculator from '../Calculator.astro';
import { type Lang, t } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);

const sections = ['trap', 'why', 'understanding', 'what'] as const;
---

<Base title={s.method.title} lang={lang} description={s.method.sub}>
  <div class="max-w-2xl mx-auto px-5 sm:px-8 py-16">
    <h1
      class="text-4xl font-extrabold mb-4"
      style="font-family:'Montserrat',sans-serif; color:#F5F7FA;"
    >
      {s.method.title}
    </h1>
    <p class="text-lg mb-14" style="color:#B0B8C8;">{s.method.sub}</p>

    <div class="flex flex-col gap-12">
      {sections.map((key) => (
        <div>
          <h2
            class="text-2xl font-extrabold mb-3"
            style="font-family:'Montserrat',sans-serif; color:#F5F7FA;"
          >
            {s.method[key].heading}
          </h2>
          <p style="color:#B0B8C8; line-height:1.75;">{s.method[key].body}</p>
        </div>
      ))}
    </div>

    <!-- Calculator entry point (ТЗ §4, #4) -->
    <div class="mt-14 rounded-2xl px-6 py-7 sm:px-8 text-center" style="background:rgba(53,198,216,.06); border:1px solid rgba(53,198,216,.3);">
      <button
        type="button"
        data-open-calc
        class="inline-flex items-center justify-center rounded-xl px-6 py-4 font-semibold transition-transform hover:-translate-y-0.5"
        style="background:#35C6D8; color:#06232A; min-height:48px;"
      >
        💰 {s.calc.methodCta} &rarr;
      </button>
    </div>

    <div class="mt-16">
      <InstallButton lang={lang} size="lg" />
    </div>
  </div>

  <Calculator lang={lang} />
</Base>

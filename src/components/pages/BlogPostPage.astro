---
import { type Lang } from '../../i18n/ui';
import { getCollection, type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'blog'>;
}

const { lang, entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.id.split('/').pop() ?? entry.id;

// Fallback for the handful of legacy/orphan drafts predating the cluster
// backlog (never published, but keep this so nothing crashes if one ever is).
function guessCluster(s: string): string {
  if (s.includes('vap')) return 'vaping';
  if (s.includes('pouch') || s.includes('snus') || s.includes('zyn')) return 'nicotine-pouches';
  return 'nicotine-science';
}
function clusterOf(e: CollectionEntry<'blog'>): string {
  return e.data.cluster ?? guessCluster(e.id.split('/').pop() ?? e.id);
}
const cluster = clusterOf(entry);

// Related-articles pool: same cluster first (true topical closeness, not a
// slug-substring guess), topped up with the most recent other-cluster posts
// so smaller clusters still get a decent-sized pool. Wider than 3 on purpose,
// BlogPost.astro picks a random 3 from this pool client-side on each visit,
// this list is not what gets shown as-is.
const RELATED_POOL_SIZE = 8;

const allPosts = await getCollection('blog', (e) =>
  e.data.lang === lang && !e.data.draft && e.id !== entry.id
);
const sameCluster = allPosts
  .filter((e) => clusterOf(e) === cluster)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const otherCluster = allPosts
  .filter((e) => clusterOf(e) !== cluster)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const related = [...sameCluster, ...otherCluster]
  .slice(0, RELATED_POOL_SIZE)
  .map((e) => ({
    title: e.data.title,
    description: e.data.description,
    slug: e.id.split('/').pop() ?? e.id,
  }));
---

<BlogPost
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  lang={lang}
  heroImage={entry.data.heroImage}
  slug={slug}
  cluster={cluster}
  related={related}
>
  <Content />
</BlogPost>

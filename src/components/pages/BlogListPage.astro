---
import Base from '../../layouts/Base.astro';
import BlogCard from '../BlogCard.astro';
import { type Lang, t } from '../../i18n/ui';
import { getCollection } from 'astro:content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);

const localeTag: Record<Lang, string> = {
  en: 'en-US', ru: 'ru-RU', de: 'de-DE', es: 'es-ES', fr: 'fr-FR',
};

const posts = (await getCollection('blog', (e) => e.data.lang === lang && !e.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const CLUSTER_ORDER = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'] as const;
const presentClusters = CLUSTER_ORDER.filter((c) => posts.some((p) => p.data.cluster === c));
---

<Base title={s.blog.title} lang={lang}>
  <div class="max-w-5xl mx-auto px-5 sm:px-8 py-16">
    <div class="flex items-end justify-between gap-4 mb-1.5">
      <h1
        class="text-4xl font-extrabold"
        style="font-family:'Montserrat',sans-serif; color:#F5F7FA;"
      >
        {s.blog.title}
      </h1>
      <span id="blog-count" class="text-sm whitespace-nowrap" style="font-family:'JetBrains Mono',monospace; color:#93A6C6;" data-locale={localeTag[lang]} data-word-one={s.blog.article} data-word-few={s.blog.articlesFew} data-word-many={s.blog.articles}></span>
    </div>

    {posts.length === 0 ? (
      <p class="mt-10" style="color:#B0B8C8;">{s.blog.empty}</p>
    ) : (
      <>
        <div class="flex items-center justify-between gap-5 flex-wrap mb-7 pb-6" style="border-bottom:1px solid #18243F;">
          <div class="flex flex-wrap gap-2" id="blog-filters">
            <button type="button" class="blog-pill active" data-filter="all">{s.blog.all}</button>
            {presentClusters.map((c) => (
              <button type="button" class="blog-pill" data-filter={c}>{s.blog.categories[c]}</button>
            ))}
          </div>
          <button type="button" id="blog-sort-btn" class="blog-sortbtn" data-newest={s.blog.sortNewest} data-oldest={s.blog.sortOldest}>
            {s.blog.sortLabel}: <span data-sort-label>{s.blog.sortNewest}</span>
            <span data-sort-arrow style="display:inline-block; transition:transform .15s;">&#9662;</span>
          </button>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="blog-grid">
          {posts.map((post) => (
            <BlogCard
              lang={lang}
              title={post.data.title}
              slug={post.id.split('/').pop()!}
              publishDate={post.data.publishDate}
              cluster={post.data.cluster}
            />
          ))}
        </div>

        <p id="blog-empty-filtered" class="mt-10 text-center" style="display:none; color:#5a6b8a;">{s.blog.emptyFiltered}</p>
      </>
    )}
  </div>
</Base>

<style>
  .blog-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    padding: 8px 14px;
    border-radius: 999px;
    cursor: pointer;
    color: #67E8F9;
    background: rgba(53, 198, 216, .06);
    border: 1px solid rgba(53, 198, 216, .3);
    transition: border-color .15s, background .15s, color .15s;
  }
  .blog-pill:hover { border-color: rgba(53, 198, 216, .5); }
  .blog-pill.active {
    color: #EAF1FF;
    background: rgba(53, 198, 216, .20);
    border-color: #35C6D8;
  }
  .blog-sortbtn {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Figtree', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #B0B8C8;
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid #22314F;
    background: rgba(19, 30, 51, .5);
    white-space: nowrap;
    cursor: pointer;
    transition: border-color .15s;
  }
  .blog-sortbtn:hover { border-color: rgba(53, 198, 216, .4); }
</style>

<script>
  function initBlogList() {
    const grid = document.getElementById('blog-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-cluster]'));
    const pills = Array.from(document.querySelectorAll<HTMLElement>('[data-filter]'));
    const sortBtn = document.getElementById('blog-sort-btn');
    const sortLabelEl = sortBtn?.querySelector('[data-sort-label]');
    const sortArrowEl = sortBtn?.querySelector<HTMLElement>('[data-sort-arrow]');
    const emptyEl = document.getElementById('blog-empty-filtered');
    const countEl = document.getElementById('blog-count');

    let filter = 'all';
    let sortDesc = true;

    function updateCount(n: number) {
      if (!countEl) return;
      const locale = countEl.dataset.locale || 'en-US';
      const cat = new Intl.PluralRules(locale).select(n);
      const word = cat === 'one'
        ? countEl.dataset.wordOne
        : cat === 'few'
          ? countEl.dataset.wordFew
          : countEl.dataset.wordMany;
      countEl.textContent = `${n} ${word}`;
    }

    function apply() {
      let visible = 0;
      cards.forEach((c) => {
        const match = filter === 'all' || c.dataset.cluster === filter;
        c.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      cards
        .slice()
        .sort((a, b) => {
          const ta = Number(a.dataset.ts);
          const tb = Number(b.dataset.ts);
          return sortDesc ? tb - ta : ta - tb;
        })
        .forEach((c) => grid!.appendChild(c));
      if (emptyEl) emptyEl.style.display = visible === 0 ? '' : 'none';
      updateCount(visible);
    }

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        filter = p.dataset.filter || 'all';
        pills.forEach((x) => x.classList.toggle('active', x === p));
        apply();
      });
    });

    sortBtn?.addEventListener('click', () => {
      sortDesc = !sortDesc;
      if (sortLabelEl) sortLabelEl.textContent = sortDesc ? sortBtn.dataset.newest! : sortBtn.dataset.oldest!;
      if (sortArrowEl) sortArrowEl.style.transform = sortDesc ? 'rotate(0deg)' : 'rotate(180deg)';
      apply();
    });

    apply();
  }

  initBlogList();
</script>

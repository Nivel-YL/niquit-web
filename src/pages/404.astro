---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist." lang="en" noindex>
  <div class="max-w-2xl mx-auto px-5 py-24 text-center">
    <h1 class="text-3xl sm:text-4xl font-extrabold mb-4" style="font-family:'Montserrat',sans-serif; color:#F5F7FA;">
      Page not found
    </h1>
    <p class="text-lg mb-8" style="color:#B0B8C8;">
      That page doesn't exist, or it moved.
    </p>
    <a
      href="/"
      class="inline-block rounded-xl px-7 py-4 font-bold transition-opacity hover:opacity-90"
      style="background:#22D3EE; color:#0C1424; font-family:'Space Grotesk',sans-serif;"
    >
      Back to NiQuit
    </a>
  </div>
</Base>

---
import Base from './Base.astro';
import ArticleCTA from '../components/ArticleCTA.astro';
import Calculator from '../components/Calculator.astro';
import { type Lang, t, localePath } from '../i18n/ui';

type RelatedPost = { title: string; description: string; slug: string };

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  lang: Lang;
  heroImage?: string;
  slug?: string;
  cluster?: string;
  related?: RelatedPost[];
}

const { title, description, publishDate, lang, heroImage, slug = '', cluster = 'nicotine-science', related = [] } = Astro.props;
const s = t(lang);

const dateStr = publishDate.toLocaleDateString(lang === 'ru' ? 'ru-RU' : lang === 'de' ? 'de-DE' : lang === 'es' ? 'es-ES' : lang === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const siteOrigin = 'https://niquit.app';
const pageUrl = `${siteOrigin}${localePath(lang, `blog/${slug}`)}`;
const isoDate = publishDate.toISOString().slice(0, 10);

// BlogPosting structured data: no rich-result eligibility depends on this
// alone, but it gives Google an unambiguous machine-readable read on
// headline/author/publisher/date instead of inferring it from the HTML,
// and is a prerequisite for article rich results (sitelinks, carousel)
// down the line. Placed in the body (inside Base's slot) rather than
// Base's <head> - Google explicitly supports JSON-LD anywhere in the
// document, and adding a per-page prop to Base for this one layout
// wasn't worth the extra surface.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: heroImage ? `${siteOrigin}${heroImage}` : undefined,
  datePublished: isoDate,
  dateModified: isoDate,
  inLanguage: lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  url: pageUrl,
  author: { '@type': 'Organization', name: 'NiQuit', url: siteOrigin },
  publisher: {
    '@type': 'Organization',
    name: 'NiQuit',
    logo: { '@type': 'ImageObject', url: `${siteOrigin}/logo.svg` },
  },
};
---

<Base title={title} description={description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="max-w-2xl mx-auto px-5 py-16">
    {heroImage && (
      <img
        src={heroImage}
        alt={title}
        class="w-full rounded-xl mb-10 object-cover"
        style="max-height:360px;"
      />
    )}

    <header class="mb-10">
      <p class="text-sm mb-3" style="color:#B0B8C8;">{dateStr}</p>
      <h1
        class="text-3xl sm:text-4xl font-extrabold leading-tight mb-4"
        style="font-family:'Montserrat',sans-serif; color:#F5F7FA;"
      >
        {title}
      </h1>
      <p class="text-lg" style="color:#B0B8C8;">{description}</p>
    </header>

    <div id="article-body" class="prose max-w-none">
      <slot />
    </div>

    <!-- Like / Dislike feedback -->
    <div
      id="article-feedback"
      class="mt-12 flex items-center gap-4"
      data-slug={slug}
    >
      <span class="text-sm" style="color:#B0B8C8;">{s.article?.feedbackPrompt ?? 'Was this helpful?'}</span>
      <button
        id="btn-like"
        type="button"
        aria-label="Like"
        class="text-xl transition-transform hover:scale-110 focus:outline-none"
        style="background:none;border:none;cursor:pointer;padding:4px;"
      >👍</button>
      <button
        id="btn-dislike"
        type="button"
        aria-label="Dislike"
        class="text-xl transition-transform hover:scale-110 focus:outline-none"
        style="background:none;border:none;cursor:pointer;padding:4px;"
      >👎</button>
    </div>

    {related.length > 0 && (
      <div class="mt-14" style="border-top:1px solid #18243F; padding-top:2.5rem;">
        <p class="text-xs font-semibold uppercase tracking-widest mb-6" style="color:#35C6D8; font-family:'JetBrains Mono',monospace;">
          {s.article?.readNext ?? 'Read next'}
        </p>
        <div id="related-articles" class="flex flex-col gap-4">
          {related.slice(0, 3).map((post) => (
            <a
              href={localePath(lang, `blog/${post.slug}`)}
              class="group flex flex-col gap-1 rounded-xl px-5 py-4 transition-colors"
              style="background:#18243F; text-decoration:none;"
            >
              <span
                class="font-bold leading-snug group-hover:text-cyan-300 transition-colors"
                style="font-family:'Montserrat',sans-serif; color:#F5F7FA;"
              >{post.title}</span>
              <span class="text-sm line-clamp-2" style="color:#B0B8C8;">{post.description}</span>
            </a>
          ))}
        </div>
        {
          /* Wider topical pool (same cluster first, then nearby ones) for the
             client to pick a random 3 from on each visit — see script below.
             Server-rendered 3 above is the no-JS / first-paint fallback. */
        }
        <script type="application/json" id="related-pool" set:html={JSON.stringify(
          related.map((post) => ({
            title: post.title,
            description: post.description,
            href: localePath(lang, `blog/${post.slug}`),
          }))
        )} />
      </div>
    )}

    <!-- Calculator entry point (ТЗ §4, #5) -->
    <div class="mt-8 text-center">
      <p class="mb-4 text-sm" style="color:#93A6C6;">{s.calc.postPrompt}</p>
      <button
        type="button"
        data-open-calc
        class="inline-flex items-center justify-center rounded-xl px-6 py-3.5 font-semibold transition-transform hover:-translate-y-0.5"
        style="background:#35C6D8; color:#06232A; min-height:46px;"
      >
        💰 {s.calc.postCta} &rarr;
      </button>
    </div>

    <div class="mt-10 pt-10" style="border-top:1px solid #18243F;">
      <ArticleCTA lang={lang} />
    </div>
  </article>

  <Calculator lang={lang} />
</Base>

<script define:vars={{ slug, cluster, lang }}>
  // 1. Article super properties — set for every event fired on this page
  (function registerArticleSuperProps() {
    if (typeof window === 'undefined') return;
    const ph = (window as any).posthog;
    if (!ph) {
      // PostHog may not be loaded yet — retry once on load
      window.addEventListener('load', () => {
        (window as any).posthog?.register({
          article_slug: slug,
          article_lang: lang,
          article_cluster: cluster,
        });
      });
      return;
    }
    ph.register({ article_slug: slug, article_lang: lang, article_cluster: cluster });
  })();

  // 2. Scroll depth tracking — fire once per threshold per page
  (function trackScrollDepth() {
    const thresholds = [25, 50, 75, 100];
    const fired = new Set<number>();
    function check() {
      const el = document.documentElement;
      const scrolled = el.scrollTop + el.clientHeight;
      const total = el.scrollHeight;
      if (total === 0) return;
      const pct = (scrolled / total) * 100;
      thresholds.forEach((t) => {
        if (!fired.has(t) && pct >= t) {
          fired.add(t);
          (window as any).posthog?.capture('article_scroll_depth', {
            platform: 'website',
            depth: t,
          });
        }
      });
    }
    window.addEventListener('scroll', check, { passive: true });
    check();
  })();

  // 3. Like / Dislike feedback
  (function setupFeedback() {
    const feedbackKey = `niquit_feedback_${slug}`;
    const container = document.getElementById('article-feedback');
    const btnLike    = document.getElementById('btn-like');
    const btnDislike = document.getElementById('btn-dislike');
    if (!container || !btnLike || !btnDislike) return;

    const already = localStorage.getItem(feedbackKey);

    function applyVoted(sentiment: string) {
      if (sentiment === 'like')    { btnLike!.style.opacity = '1'; btnDislike!.style.opacity = '0.3'; }
      if (sentiment === 'dislike') { btnDislike!.style.opacity = '1'; btnLike!.style.opacity = '0.3'; }
      btnLike!.disabled    = true;
      btnDislike!.disabled = true;
    }

    if (already) { applyVoted(already); return; }

    function vote(sentiment: 'like' | 'dislike') {
      localStorage.setItem(feedbackKey, sentiment);
      (window as any).posthog?.capture('article_feedback', {
        platform: 'website',
        sentiment,
      });
      applyVoted(sentiment);
    }

    btnLike.addEventListener('click', () => vote('like'));
    btnDislike.addEventListener('click', () => vote('dislike'));
  })();

  // 4. Internal link tracking — same-domain article links
  (function trackInternalLinks() {
    const articleBody = document.getElementById('article-body');
    if (!articleBody) return;
    articleBody.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a') as HTMLAnchorElement | null;
      if (!a) return;
      const href = a.getAttribute('href') ?? '';
      const isInternal =
        href.startsWith('/') ||
        href.includes('niquit.app') ||
        a.hostname === window.location.hostname;
      const isBlogLink = href.includes('/blog/') || href.match(/\/[a-z]{2}\/blog\//);
      if (isInternal && isBlogLink) {
        const toSlug = href.split('/').filter(Boolean).pop() ?? href;
        (window as any).posthog?.capture('internal_link_clicked', {
          platform: 'website',
          from_article: slug,
          to_article: toSlug,
        });
      }
    });
  })();

  // 5. "Read next": pick a random 3 from the wider topical pool on each visit,
  // instead of always showing the same server-rendered ones.
  (function shuffleRelated() {
    const poolEl = document.getElementById('related-pool');
    const container = document.getElementById('related-articles');
    if (!poolEl || !container) return;

    let pool: { title: string; description: string; href: string }[];
    try {
      pool = JSON.parse(poolEl.textContent || '[]');
    } catch {
      return;
    }
    if (pool.length <= 3) return; // already showing everything there is

    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }

    container.innerHTML = '';
    pool.slice(0, 3).forEach((post) => {
      const a = document.createElement('a');
      a.href = post.href;
      a.className = 'group flex flex-col gap-1 rounded-xl px-5 py-4 transition-colors';
      a.style.background = '#18243F';
      a.style.textDecoration = 'none';

      const titleSpan = document.createElement('span');
      titleSpan.className = 'font-bold leading-snug group-hover:text-cyan-300 transition-colors';
      titleSpan.style.fontFamily = "'Montserrat',sans-serif";
      titleSpan.style.color = '#F5F7FA';
      titleSpan.textContent = post.title;

      const descSpan = document.createElement('span');
      descSpan.className = 'text-sm line-clamp-2';
      descSpan.style.color = '#B0B8C8';
      descSpan.textContent = post.description;

      a.appendChild(titleSpan);
      a.appendChild(descSpan);
      container.appendChild(a);
    });
  })();
</script>
